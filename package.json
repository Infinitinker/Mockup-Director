{
  "name": "mockup-director",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Your artwork, as a real product. Photorealistic 3D mockups of boxes, disc cases, books, print and devices, made on your own computer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tools && tsc -p tests/e2e && vite build",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write",
    "test": "vitest run",
    "licenses": "node tools/licenses.mjs",
    "notices": "node tools/notices.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "e2e:build": "node tools/e2e-build.mjs",
    "e2e": "wdio run tests/e2e/wdio.config.ts",
    "screenshots": "wdio run tests/e2e/screenshots.config.ts",
    "icons": "node tools/draw-icon.mjs",
    "installer": "node tools/installer.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "mediabunny": "1.62.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/tauri-plugin": "2.0.0-next.0",
    "@wdio/tauri-service": "2.0.0-next.0",
    "@wdio/types": "^10.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "webdriverio": "^10.2.0"
  },
  "overrides": {
    "mocha": {
      "glob": "^14.0.5",
      "minimatch": "^11.0.5"
    },
    "readdir-glob": {
      "minimatch": "^11.0.5"
    }
  }
}
